{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digitalie.local/schemas/statistical-analysis.schema.json",
  "title": "Statistical Analysis Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "case_id",
    "method",
    "population_or_estimand",
    "sampling_unit",
    "operational_definition",
    "units",
    "data_structure",
    "study_design",
    "sampling_design",
    "input_evidence_ids",
    "equations",
    "results",
    "assumptions",
    "interpretation",
    "authority_boundary"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "case_id": { "type": "string", "minLength": 1 },
    "method": { "type": "string", "minLength": 1 },
    "population_or_estimand": { "type": "string", "minLength": 1 },
    "sampling_unit": { "type": "string", "minLength": 1 },
    "operational_definition": { "type": "string", "minLength": 1 },
    "units": { "type": "string", "minLength": 1 },
    "data_structure": {
      "type": "string",
      "enum": ["nominal", "ordinal", "interval", "ratio", "mixed"]
    },
    "study_design": { "type": "string", "minLength": 1 },
    "sampling_design": { "type": "string", "minLength": 1 },
    "input_evidence_ids": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "uniqueItems": true
    },
    "filters_and_missingness": { "type": "string" },
    "equations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "formula", "substitution"],
        "properties": {
          "name": { "type": "string" },
          "formula": { "type": "string" },
          "substitution": { "type": "string" }
        }
      }
    },
    "software": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "package": { "type": "string" },
        "function": { "type": "string" },
        "version": { "type": "string" },
        "code_reference": { "type": "string" }
      }
    },
    "results": { "type": "object" },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "diagnostics": { "type": "array", "items": { "type": "string" } },
    "interpretation": { "type": "string", "minLength": 1 },
    "not_established": { "type": "array", "items": { "type": "string" } },
    "reviewed_by": { "type": ["string", "null"] },
    "authority_boundary": { "type": "string", "minLength": 1 }
  }
}
