{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digitalie.dev/schemas/case.schema.json",
  "title": "Improvement Case",
  "type": "object",
  "required": ["id", "title", "status", "process", "created_at"],
  "properties": {
    "id": {"type": "string", "pattern": "^DIE-[0-9]{4}-[0-9]{4}$"},
    "title": {"type": "string", "minLength": 8},
    "status": {"enum": ["triage", "containment", "investigate", "improve", "control", "closed"]},
    "process": {"type": "string"},
    "problem_statement": {"type": "string"},
    "ctqs": {"type": "array", "items": {"type": "string"}},
    "created_at": {"type": "string", "format": "date-time"},
    "owner": {"type": "string"}
  },
  "additionalProperties": false
}
