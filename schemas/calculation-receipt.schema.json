{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digitalie.local/schemas/calculation-receipt.schema.json",
  "title": "DigitalIE Calculation Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "calculation_id",
    "method",
    "method_version",
    "formulas",
    "inputs",
    "context",
    "intermediates",
    "results",
    "mechanically_validated",
    "context_gaps",
    "assumptions_not_established",
    "authority_boundary"
  ],
  "properties": {
    "calculation_id": { "type": "string", "pattern": "^calc-[0-9a-f]{20}$" },
    "method": { "type": "string", "minLength": 1 },
    "method_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "formulas": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "inputs": { "type": "object" },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "case_id": { "type": "string" },
        "analysis_id": { "type": "string" },
        "evidence_ids": { "type": "array", "items": { "type": "string" } },
        "units": { "type": "string" },
        "purpose": { "type": "string" }
      }
    },
    "intermediates": { "type": "object" },
    "results": { "type": "object", "minProperties": 1 },
    "mechanically_validated": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "context_gaps": { "type": "array", "items": { "type": "string" } },
    "assumptions_not_established": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "authority_boundary": { "type": "string", "minLength": 1 }
  }
}
